# Skopiuj do .env i dostosuj. Zmienne są opcjonalne (mają domyślne wartości).

# Klucz produkcyjny (wygeneruj własny!)
# DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE

# Tryb debug (1/0)
DJANGO_DEBUG=1

# Dozwolone hosty, oddzielone przecinkami
DJANGO_ALLOWED_HOSTS=*

# Strefa czasowa
DJANGO_TIME_ZONE=Europe/Warsaw

# Baza danych — domyślnie SQLite. Aby użyć PostgreSQL, odkomentuj:
# DATABASE_URL=YOUR_DATABASE_URL_HERE

# Zaufane origins dla CSRF (gdy za reverse-proxy/HTTPS), np.:
# DJANGO_CSRF_TRUSTED_ORIGINS=YOUR_DJANGO_CSRF_TRUSTED_ORIGINS_HERE

# Liczba zaufanych proxy przed aplikacją (0 = lokalnie bez proxy; za Caddy/Traefik: 1).
# Od tego zależy IP w limicie logowań i w dzienniku logowań.
# DJANGO_TRUSTED_PROXY_COUNT=0

# Tryb demo: baner, przycisk „Wejdź jako demo”, panel „Od czego zacząć”, konta demo
# (po `python manage.py seed_demo`). Konta demo są publiczne — opisane w README.
# DEMO_MODE=1
# DEMO_VISITOR_GATE=1   # przy DEMO_MODE: formularz „przedstaw się” przed wejściem (0 = wyłączona)
# Przepustka z portfolio: gość, który przedstawił się w portfolio (ciasteczko `gosc`), omija bramkę.
# PORTFOLIO_URL musi zaczynać się od https://; PORTFOLIO_PASS=0 wyłącza sprawdzanie.
# PORTFOLIO_URL=https://portfolio.twapp.pl
# PORTFOLIO_PASS=1
# Powiadomienie push (aplikacja ntfy) o każdym nowym gościu demo — pełny URL tematu
# (tajny, trudny do zgadnięcia; może być własny serwer ntfy). Puste = wyłączone.
# NTFY_URL=https://ntfy.sh/YOUR_SECRET_TOPIC_HERE
# NTFY_TOKEN=YOUR_NTFY_TOKEN_HERE   # opcjonalnie: serwer ntfy z kontrolą dostępu
# NTFY_WATCH_COMPANIES=fraza1, fraza2   # firmy z alarmem (push urgent); prawdziwe nazwy tylko w Coolify
# NTFY_ENGAGED_VIEWS=10                 # push, gdy gość obejrzy N ekranów; 0 = wyłączone
# DEMO_USER=demo_operator
# DEMO_PASSWORD=demo1234
